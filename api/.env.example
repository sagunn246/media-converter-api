# Application Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# File Upload Settings
MAX_FILE_SIZE_MB=500
UPLOAD_DIR=uploads
OUTPUT_DIR=output

# File Retention Policy
FILE_RETENTION_HOURS=24
CLEANUP_CRON_SCHEDULE=0 * * * *

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_CONVERT=10

# Database Configuration
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/media-converter
# MongoDB Atlas Cloud (Uncomment and replace credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/media-converter?retryWrites=true&w=majority

