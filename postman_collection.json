    {
      "name": "Convert Media to MP3",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "bitrate",
              "value": "320",
              "type": "text",
              "description": "Optional bitrate: 128, 192, 256, 320 (Default: 320)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert"
          ]
        },
        "description": "Upload a video or audio file (mp4, mov, avi, mkv, webm, mp3, wav, aac, m4a up to 500MB) to convert to MP3."
      },
      "response": []
    },
    {
      "name": "Download or Stream MP3 File",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/download/:filename",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "download",
            ":filename"
          ],
          "variable": [
            {
              "key": "filename",
              "value": "sample-converted.mp3",
              "description": "The converted MP3 filename returned from /api/convert"
            }
          ]
        },
        "description": "Downloads or streams the converted MP3 file."
      },
      "response": []
    },
    {
      "name": "Delete Converted File",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/file/:filename",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "file",
            ":filename"
          ],
          "variable": [
            {
              "key": "filename",
              "value": "sample-converted.mp3",
              "description": "The converted MP3 filename to delete"
            }
          ]
        },
        "description": "Manually deletes a converted file from storage."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
